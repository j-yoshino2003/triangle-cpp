    </Link>
  </ItemDefinitionGroup>
  <!-- シェーダー 1 枚ごとの規則。CustomBuild 項目を足すだけで対象が増える. -->
  <ItemDefinitionGroup>
    <CustomBuild>
      <FileType>Document</FileType>
      <Message>glslc %(Identity)</Message>
      <Command>if not exist "$(OutDir)shaders\" mkdir "$(OutDir)shaders\"
"$(VULKAN_SDK)\Bin\glslc.exe" "%(FullPath)" -o "$(OutDir)shaders\%(Filename)%(Extension).spv"</Command>
      <Outputs>$(OutDir)shaders\%(Filename)%(Extension).spv</Outputs>
    </CustomBuild>
  </ItemDefinitionGroup>
