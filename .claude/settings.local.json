{
  "extraKnownMarketplaces": {
    "edit-scope-guard": {
      "source": {
        "source": "directory",
        "path": "./.claude/vendor/edit-scope-guard"
      }
    },
    "desktop-notify": {
      "source": {
        "source": "directory",
        "path": "./.claude/vendor/desktop-notify"
      }
    },
    "scm-guard": {
      "source": {
        "source": "directory",
        "path": "./.claude/vendor/scm-guard"
      }
    },
    "git-harness": {
      "source": {
        "source": "directory",
        "path": "./.claude/vendor/git-harness"
      }
    },
    "p4-harness": {
      "source": {
        "source": "directory",
        "path": "./.claude/vendor/p4-harness"
      }
    }
  },
  "enabledPlugins": {
    "edit-scope-guard@edit-scope-guard": true,
    "desktop-notify@desktop-notify": true,
    "scm-guard@scm-guard": true,
    "git-harness@git-harness": true,
    "p4-harness@p4-harness": true
  },
  "model": "opus",
  "language": "japanese",
  "effortLevel": "medium",
  "enableWorkflows": true,
  "autoCompactEnabled": true,
  "teammateMode": "auto",
  "env": {
